# Required: TeamGantt personal access token
# Create one at https://app.teamgantt.com/admin/developers/tokens
TEAMGANTT_API_TOKEN=

# Optional: override the API base URL (default: https://api.teamgantt.com)
# TEAMGANTT_BASE_URL=https://api.teamgantt.com

# Optional: HTTP transport settings (used with --http)
# PORT=3000
# MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: log level (error | warn | info | debug), default info
# LOG_LEVEL=info
